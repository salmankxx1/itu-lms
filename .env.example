# SMTP Email Configuration (Gmail App Password)
# To enable real Gmail sending:
# 1. Enable 2-Step Verification in Google Account -> Security
# 2. Generate an "App Password" (16 characters)
# 3. Fill in your Gmail and App Password below:

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=ITU Lahore Portal
FRONTEND_URL=http://localhost:5173/login

# Database and auth (required)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost/Students
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional: comma-separated browser origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: first admin for seed_admin.py (a random password is printed if unset)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=

# Production email. Hosts such as Render block SMTP, so use the Brevo HTTPS API.
# When set, this is used instead of the SMTP settings above.
BREVO_API_KEY=

# Set to production when hosted. Turns off the API docs and local-network access.
ENVIRONMENT=development
